# Chat model provider — OpenAI-compatible chat-completions API.
# The client speaks the OpenAI request/response format, so swapping
# providers is an env change, not a code change. Defaults point at OpenAI.
# When no key is set, the app runs on the deterministic mock model.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_ID=gpt-4o-mini

# Fallback for MODEL_API_KEY (used when MODEL_API_KEY is empty). Also used
# by the /api/voice/session route to mint ephemeral Realtime keys and by
# the embeddings client (text-embedding-3-small) when it lands.
OPENAI_API_KEY=

# Supabase project URL (public by design; useless without a key + policies).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — present for completeness. The app does NOT use it:
# RLS denies anon everything on all tables, and the browser never
# constructs a Supabase client. Leave empty unless a future feature needs it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Bypasses RLS; used by API routes,
# ingestion, and seed scripts. Never expose this to the browser, never
# commit it. When unset, the app runs in demo mode (in-memory store +
# local RAG corpus).
SUPABASE_SERVICE_ROLE_KEY=

# Canonical demo URL.
NEXT_PUBLIC_APP_URL=
